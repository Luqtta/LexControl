# LexControl Environment Configuration
# Copy this file to .env.local and fill in actual values

# ============ BACKEND CONFIGURATION ============

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/lexcontrol
DB_USER=lexcontrol
DB_PASSWORD=lexcontrol

# JWT Configuration
# RSA key pair for JWT signing (RS256). Generate with:
# openssl genrsa -out private-key.pem 4096
# openssl rsa -in private-key.pem -pubout -out public-key.pem
# Keys should be in PEM format with \n for newlines (when set as environment variables)
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n
JWT_EXPIRATION=3600

# CORS Configuration
# Must match frontend URL exactly (including protocol)
CORS_ORIGINS=http://localhost:5173

# Server Configuration
QUARKUS_HTTP_CORS_ENABLED=true
PORT=8080

# ============ FRONTEND CONFIGURATION ============

# API Base URL
VITE_API_URL=http://localhost:8080

# ============ PRODUCTION NOTES ============

# For Railway deployment:
# 1. Generate new JWT keys (don't reuse dev keys)
# 2. Use strong database password (20+ chars)
# 3. Set CORS_ORIGINS to production frontend domain
# 4. Never commit real credentials to git
# 5. Use Railway Secrets for sensitive values

# Health Check
# Development: http://localhost:8080/q/health
# Production: https://your-api-domain.railway.app/q/health

